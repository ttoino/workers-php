#!/usr/bin/env make
# Cloudflare Workers-compatible build settings for seanmorris/php-wasm.
#
# Based on the upstream CI's `.env_8.5.static.ci` (the only "static" build
# flavor Sean's CI exercises). Static-linked extensions guarantee MAIN_MODULE=0
# behavior — no runtime `new WebAssembly.Module(bytes)` calls — which is
# required by Cloudflare Workers.
#
# WITH_*=0 doesn't work here: with everything set to 0, PHP_CONFIGURE_DEPS
# stays empty, causing `make web-mjs` to call `$(MAKE)` with no targets,
# which triggers the `all` target → infinite recursion.

PHP_VERSION=8.5

WITH_SOURCEMAPS=0
ASSERTIONS=0
OPTIMIZE=3
SYMBOLS=0

# Cloudflare Workers compat: forbid runtime WebAssembly compilation by
# building the wasm without dynamic linker support.
MAIN_MODULE=0
ASYNCIFY=1

# Skip the pdo-pglite extension (uses JS interop we don't need)
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_VRZNO=0

# Core extensions (no external dependencies)
WITH_BCMATH=1
WITH_CALENDAR=1
WITH_CTYPE=1
WITH_EXIF=1
WITH_FILTER=1
WITH_TOKENIZER=1

# Statically-linked extensions
WITH_PHAR=static

WITH_LIBXML=static
WITH_DOM=static
WITH_XML=static
WITH_SIMPLEXML=static
WITH_XMLREADER=static
WITH_XMLWRITER=static
WITH_TIDY=static

WITH_LIBZIP=static
WITH_ICONV=static
WITH_SQLITE=static

# GD + image libs enabled. Bumps the wasm by ~1.7 MB raw / ~250 KB gzip,
# but apps that handle uploaded images (imagecreatefromstring, imagewebp,
# etc.) need this. Flip these back to 0 if you only serve text and want
# the smallest possible bundle.
WITH_GD=static
WITH_ZLIB=static
WITH_LIBPNG=static
WITH_FREETYPE=static
WITH_LIBJPEG=static
WITH_LIBWEBP=static

WITH_YAML=static
WITH_MBSTRING=static
WITH_ONIGURUMA=static
WITH_OPENSSL=static
# INTL disabled: WITH_INTL=static compiles ICU 72.1 into the wasm (+~15 MB
# uncompressed — affordable under the 64 MiB Worker limit) BUT it also adds
# the ICU data file (icudt72l.dat) to PRELOAD_ASSETS, producing an Emscripten
# preload .data file that the workers-php runtime would have to fetch and
# mount next to php-web.wasm. That plumbing doesn't exist yet, so intl stays
# off. (Historical note: EMSDK <= 3.1.43 also rejected the --preload-name
# emcc flag; 3.1.74 accepts it, so the preload mechanism itself builds now.)
WITH_INTL=0

WITH_WAITLINE=1

# NOTE: extra ./configure flags (e.g. --enable-fileinfo, which has no
# WITH_FILEINFO knob upstream) can't live here because this file is also
# parsed by docker-compose, which rejects make's `+=` operator. Such flags
# are injected from build/build-php-wasm.sh by patching upstream's Makefile
# instead. Plain `KEY=value` assignments are fine here.
