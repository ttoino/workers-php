#!/usr/bin/env make
# Cloudflare Workers-compatible build settings for seanmorris/php-wasm.
#
# Based on upstream CI's .env_8.5.static.ci. Static linking keeps
# MAIN_MODULE=0 — no runtime WebAssembly.Module compilation, which
# Workers forbids.
#
# WITH_*=0 across the board breaks the build: an empty PHP_CONFIGURE_DEPS
# makes `make web-mjs` recurse into `all` forever.

PHP_VERSION=8.5

WITH_SOURCEMAPS=0
ASSERTIONS=0
OPTIMIZE=3
SYMBOLS=0

MAIN_MODULE=0
ASYNCIFY=1

# These three extensions rely on JS interop this runtime doesn't use.
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_VRZNO=0

# Core extensions (no external dependencies)
WITH_BCMATH=1
WITH_CALENDAR=1
WITH_CTYPE=1
WITH_EXIF=1
WITH_FILTER=1
WITH_TOKENIZER=1

# Statically-linked extensions
WITH_PHAR=static

WITH_LIBXML=static
WITH_DOM=static
WITH_XML=static
WITH_SIMPLEXML=static
WITH_XMLREADER=static
WITH_XMLWRITER=static
WITH_TIDY=static

WITH_LIBZIP=static
WITH_ICONV=static
WITH_SQLITE=static

# GD + image libs: +~1.7 MB raw / ~250 KB gzip. Set to 0 when only
# serving text.
WITH_GD=static
WITH_ZLIB=static
WITH_LIBPNG=static
WITH_FREETYPE=static
WITH_LIBJPEG=static
WITH_LIBWEBP=static

WITH_YAML=static
WITH_MBSTRING=static
WITH_ONIGURUMA=static
WITH_OPENSSL=static
# INTL off: static intl adds ICU 72.1 (+~15 MB) and its icudt72l.dat to
# PRELOAD_ASSETS, producing a .data file the runtime would have to fetch
# and mount next to php-web.wasm — plumbing that doesn't exist yet.
WITH_INTL=0

WITH_WAITLINE=1

# Extra ./configure flags (--enable-fileinfo etc., no WITH_* knob) can't
# live here: docker-compose also parses this file and rejects `+=`. They
# are injected into upstream's Makefile by build-php-wasm.sh instead.
