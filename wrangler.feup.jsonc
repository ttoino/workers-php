/**
 * Wrangler config for the xaufome / feup-ltw-proj deployment.
 *
 * Use with: `npm run dev:feup` or `npm run deploy:feup`. The base
 * wrangler.jsonc (without `.feup`) still drives the small built-in demo
 * Worker; both share the same workers-php library but bundle different
 * PHP projects.
 *
 * Persistence is backed by Cloudflare D1 (relational data) and R2
 * (user-uploaded images). Before first use:
 *
 *   wrangler d1     create xaufome-db
 *   wrangler r2     bucket create xaufome-images
 *   npm run feup:migrate:local    # seed schema + populate into the local D1
 *
 * Paste the resulting D1 UUID over `database_id` below.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "xaufome",
	"main": "src/feup-index.ts",
	"compatibility_date": "2026-05-26",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// The xaufome PHP project gets bundled into ./dist-feup/app.tar.gz by
	// `npm run build-feup`. The runtime fetches it on first request via
	// env.ASSETS and mounts it into the in-process PHP FS. Static files
	// (CSS/JS/built-in placeholder SVGs) are served from ASSETS; user-
	// uploaded images are served from R2 via `staticRoutes`.
	"assets": {
		"directory": "./dist-feup",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "xaufome-db",
			"database_id": "15f86bc1-80ae-4748-8848-18c8472e4e95"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "xaufome-images"
		}
	],
	// The workers-php library imports .php helper files as string modules.
	"rules": [
		{ "type": "Text", "globs": ["**/*.php"], "fallthrough": true }
	]
}
