/**
 * Wrangler config for the xaufome / feup-ltw-proj deployment; use with
 * `npm run dev:feup` / `npm run deploy:feup`.
 *
 * First-time setup:
 *   wrangler d1     create xaufome-db
 *   wrangler r2     bucket create xaufome-images
 *   npm run feup:migrate:local
 *
 * Paste the resulting D1 UUID over `database_id` below.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "xaufome",
	"main": "src/feup-index.ts",
	"compatibility_date": "2026-05-26",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Holds app.tar.gz + statics, produced by `npm run build-feup`.
	// Uploads are served from R2 via `staticRoutes` instead.
	"assets": {
		"directory": "./dist-feup",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "xaufome-db",
			"database_id": "15f86bc1-80ae-4748-8848-18c8472e4e95"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "xaufome-images"
		}
	],
	// The workers-php library imports .php helper files as string modules.
	"rules": [
		{ "type": "Text", "globs": ["**/*.php"], "fallthrough": true }
	]
}
