{
  "name": "php-wasm-worker-demo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build-php": "workers-php build ./php --docroot . --entrypoint router.php",
    "dev": "npm run build-php --silent && wrangler dev",
    "start": "npm run dev",
    "deploy": "npm run build-php --silent && wrangler deploy",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "build-wasm": "bash build/build-php-wasm.sh",
    "wasm-promote": "bash build/promote-wasm.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.9.1",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "workers-php": "*"
  }
}
