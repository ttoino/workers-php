{
    "name": "workers-php",
    "version": "2.0.0",
    "description": "PHP on Cloudflare Workers, Durable Objects and Containers",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ttoino/workers-php.git"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./hyperdrive": "./src/hyperdrive.ts"
    },
    "files": [
        "src",
        "php",
        "etc"
    ],
    "peerDependencies": {
        "postgres": ">=3.4.5"
    },
    "peerDependenciesMeta": {
        "postgres": {
            "optional": true
        }
    },
    "scripts": {
        "build": "pnpm --filter workers-php-example-laravel run build",
        "check": "tsc --noEmit && pnpm --filter workers-php-example-laravel run check",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run"
    },
    "dependencies": {
        "mimetext": "^3.0.28"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260930.2",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.12.1",
        "globals": "^17.12.0",
        "postgres": "^3.4.9",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.2"
    },
    "packageManager": "pnpm@12.4.1"
}
