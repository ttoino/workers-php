{
    "name": "workers-php/workers-php",
    "description": "PHP runtime for workers-php: D1, R2 and Mail HTTP clients plus Laravel and Symfony integrations.",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ext-curl": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2",
        "larastan/larastan": "^3.12",
        "laravel/framework": "^13.32",
        "symfony/mailer": "^8.1",
        "phpstan/extension-installer": "*",
        "orchestra/testbench": "^11.2"
    },
    "suggest": {
        "laravel/framework": "Enables the service providers, D1 connection, R2 filesystem and mailer integrations.",
        "symfony/mailer": "Enables the WorkersPhp\\Symfony mail transport."
    },
    "autoload": {
        "psr-4": {
            "WorkersPhp\\": "php/base/",
            "WorkersPhp\\Laravel\\": "php/laravel/",
            "WorkersPhp\\Symfony\\": "php/symfony/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorkersPhp\\Tests\\": "php/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WorkersPhp\\Laravel\\CloudflareServiceProvider",
                "WorkersPhp\\Laravel\\D1ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyze": "phpstan analyse",
        "format": "pint --test",
        "format:fix": "pint",
        "test": "phpunit"
    }
}
