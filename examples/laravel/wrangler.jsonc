{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "workers-php-example-laravel",
    "main": "worker.ts",
    "compatibility_date": "2026-09-15",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
    },
    "containers": [
        {
            "name": "app",
            "class_name": "AppContainer",
            "image": "./Dockerfile",
            "image_build_context": "../..",
            "max_instances": 1,
            "instance_type": "basic",
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "CONTAINER",
                "class_name": "AppContainer",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["AppContainer"],
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "workers-php-example-laravel",
            "database_id": "00000000-0000-0000-0000-000000000000",
        },
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "workers-php-example-laravel",
        },
    ],
    "send_email": [
        {
            "name": "EMAIL",
            "allowed_sender_addresses": ["noreply@example.com"],
        },
    ],
}
