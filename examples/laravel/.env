APP_NAME="workers-php laravel"
APP_ENV=production
APP_KEY=base64:OmdCv7ytp9z2+N82FGPZC50Ko1Vv2wHTu6/Qm2npdrY=
APP_DEBUG=false
APP_URL=https://workers-php-laravel.toino.workers.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=errorlog
LOG_LEVEL=info

# Custom driver registered by App\Providers\D1ServiceProvider; the name
# matches the D1 binding in wrangler.laravel.jsonc.
DB_CONNECTION=d1
DB_D1_BINDING=DB

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
