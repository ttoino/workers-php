# Reference Caddyfile, equivalent to the one baked into the FrankenPHP
# image (/etc/frankenphp/Caddyfile). Ship it only to customize; otherwise
# the image default needs no copy.

{
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}
	encode zstd br gzip
	php_server
}

# Internal queue consume endpoint; never routed publicly. The app
# worker forwards Cloudflare Queue messages here when `consume` is on.
:{$QUEUE_CONSUME_PORT:8081} {
	root {$QUEUE_CONSUME_ROOT:/etc/workers-php}
	rewrite * /queue-consumer.php
	php_server
}
