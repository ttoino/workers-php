{
  "name": "workers-php",
  "version": "0.0.1",
  "description": "Run a PHP project on Cloudflare Workers, with the project served from the Workers ASSETS binding so it doesn't count against the Worker bundle size cap.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ambient": "./src/ambient.d.ts"
  },
  "bin": {
    "workers-php": "./bin/workers-php.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "cloudflare",
    "workers",
    "php",
    "wasm",
    "webassembly",
    "laravel"
  ]
}
