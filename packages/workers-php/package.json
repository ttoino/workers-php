{
  "name": "workers-php",
  "version": "0.1.0",
  "description": "Run a PHP project on Cloudflare Workers, with the project served from the Workers ASSETS binding so it doesn't count against the Worker bundle size cap.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ambient": "./src/ambient.d.ts"
  },
  "bin": {
    "workers-php": "./bin/workers-php.mjs"
  },
  "files": [
    "bin",
    "src",
    "php",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "cloudflare",
    "workers",
    "php",
    "wasm",
    "webassembly",
    "laravel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttoino/php-wasm-worker.git",
    "directory": "packages/workers-php"
  },
  "homepage": "https://github.com/ttoino/php-wasm-worker#readme",
  "bugs": "https://github.com/ttoino/php-wasm-worker/issues"
}
